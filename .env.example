# Copy this file to `.env` for local development.
# `.env` is gitignored and must never be committed.
#
# The desktop app normally reads the OBS WebSocket password directly from
# OBS's own config (%APPDATA%\obs-studio\plugin_config\obs-websocket\config.json).
# Only set this variable to override that value. Never commit a real password.
OBS_WS_PASSWORD=

# Local RTMP endpoint used by the Phase 2 streaming bring-up (MediaMTX/VLC).
# These are throwaway local values, not production stream keys.
VIDYST_RTMP_URL=rtmp://127.0.0.1/live
VIDYST_RTMP_KEY=dev
